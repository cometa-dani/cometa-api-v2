generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model Organization {
  id            Int        @id @default(autoincrement())
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  uid           String?    @unique
  avatarUrl     String?    @map("avatar_url")
  name          String     @unique @db.VarChar(255)
  email         String     @unique
  phone         String?
  description   String?
  webPage       String?    @map("web_page")
  instagramPage String?    @map("instagram_page")
  facebookPage  String?    @map("facebook_page")
  events        Event[]
  locations     Location[]
}

model Location {
  id             Int           @id @default(autoincrement())
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  name           String        @unique @db.VarChar(255)
  description    String?
  latitude       Float?
  longitude      Float?
  organizationId Int?
  mapUrl         String?       @map("map_url")
  mapCid         String?       @map("map_cid")
  events         Event[]
  Organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Event {
  id             Int             @id @default(autoincrement())
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  date           DateTime
  name           String          @db.VarChar(255)
  description    String
  categories     EventCategory[] @default([])
  locationId     Int             @map("location_id")
  organizationId Int?            @map("organization_id")
  location       Location        @relation(fields: [locationId], references: [id])
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  likes          EventLike[]
  photos         EventPhoto[]
  shares         EventShare[]

  @@unique([date, locationId])
}

model EventPhoto {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  url         String?
  placeholder String?
  order       Int
  eventId     Int      @map("event_id")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventLike {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  eventId   Int      @map("event_id")
  userId    Int      @map("user_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventShare {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  eventId   Int      @map("event_id")
  userId    Int      @map("user_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                    Int                 @id @default(autoincrement())
  createdAt             DateTime?           @default(now()) @map("created_at")
  updatedAt             DateTime?           @updatedAt @map("updated_at")
  email                 String              @unique
  phone                 String?             @unique
  username              String              @unique
  name                  String?
  biography             String?
  birthday              DateTime?
  interests             EventCategory[]     @default([])
  activateNotifications Boolean             @default(false) @map("activate_notifications")
  currentLocation       String?             @map("current_location")
  homeTown              String?             @map("home_town")
  languages             String[]            @default([])
  height                Int?
  weight                Int?
  favoriteSports        String[]            @default([]) @map("favorite_sports")
  music                 String[]            @default([])
  lookingFor            LookingFor?         @map("looking_for")
  occupation            String?
  educationLevel        Education?          @map("education_level")
  relationshipStatus    RelationshipStatus? @map("relationship_status")
  pets                  String[]            @default([])
  smoking               Boolean?
  drinking              Boolean?
  ethnicity             Ethnicity?
  children              Boolean?
  company               String?
  verified              Boolean?            @default(false)
  gender                Gender?
  exerciseFrequency     ExerciseFrequency?  @map("exercise_frequency")
  uid                   String?             @unique @db.Uuid
  // chatGroupAsAdmin      ChatGroup[]         @relation("ChatGroupAdmin")
  likedEvents           EventLike[]
  sharedEvents          EventShare[]
  incomingFriendships   Friendship[]        @relation("ReceiverFriendship")
  outgoingFriendships   Friendship[]        @relation("SenderFriendship")
  photos                UserPhoto[]
  // chatGroupMemberships  ChatGroup[]         @relation("ChatGroupMember")
  // chatParticipations    ChatParticipant[]
  incomingNotification  Notification[]      @relation("ReceiverNotifications")
  outgoingNotification  Notification[]      @relation("SenderNotifications")
  notifications         Notification[]      @relation("User")
}

model UserPhoto {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  url         String?
  placeholder String?
  order       Int?
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id            Int              @id @default(autoincrement())
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  sender        User             @relation("SenderFriendship", fields: [senderId], references: [id], onDelete: Cascade)
  senderId      Int              @map("sender_id")
  receiver      User             @relation("ReceiverFriendship", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId    Int              @map("receiver_id")
  messages      Json[]           @default([])
  status        FriendshipStatus @default(PENDING)
  lastMessageAt DateTime?        @map("last_message_at")

  @@unique([senderId, receiverId])
  @@index([lastMessageAt]) // Optional: Add index if you'll sort by last message
  @@index([senderId])
  @@index([receiverId])
}

